# Supabase — projeto dedicado "agente-comercial-toledo" (ref xdzkpjqycnjcaohzuprv)
NEXT_PUBLIC_SUPABASE_URL=https://xdzkpjqycnjcaohzuprv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — nunca expor ao cliente. Usada só nas Route Handlers (app/api/**)
# para o agente de IA e a geração de apresentação lerem dados revisados direto do banco.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — usado apenas para busca em linguagem natural e texto da apresentação.
# Nunca para gerar números/specs: isso vem sempre do Supabase, lido por código.
ANTHROPIC_API_KEY=

# Login restrito por domínio de e-mail corporativo (Google SSO via Supabase Auth).
# Preencher com o domínio real da Toledo antes de liberar para o time de vendas.
ALLOWED_EMAIL_DOMAIN=
